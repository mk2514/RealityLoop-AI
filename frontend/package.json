{
  "name": "realityloop-application",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/validate-vercel-env.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run build && vitest run --environment jsdom && node ../tests/model.test.mjs",
    "test:smoke": "playwright test --config playwright.smoke.config.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "@xyflow/react": "^12.12.1",
    "echarts": "^5.6.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.180.0",
    "vite": "6.4.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "26.6.6",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.7",
    "@types/three": "0.180.0",
    "autoprefixer": "10.4.21",
    "jsdom": "26.1.0",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "vitest": "4.1.12"
  }
}
