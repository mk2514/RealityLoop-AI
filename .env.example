# Local-only defaults; do not use these values for production deployment.
ENVIRONMENT=development
LOG_LEVEL=INFO
MONGO_URI=mongodb://127.0.0.1:27017/realityloop?replicaSet=rs0
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=realityloop
MONGO_APP_USERNAME=realityloop-app
MONGO_APP_PASSWORD=replace-with-a-local-application-database-password
MONGO_AUTH_SOURCE=realityloop
REDIS_URL=redis://localhost:6379/0
# Hosted Redis must use TLS: rediss://user:pass@host:6379/0  (the worker appends ssl_cert_reqs=CERT_REQUIRED for Celery)
FRONTEND_ORIGINS=http://localhost:5173
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=realityloop-local
S3_ACCESS_KEY_ID=realityloop-local
S3_SECRET_ACCESS_KEY=replace-with-a-local-minio-secret
SENSOR_IMPORT_MAX_FILE_BYTES=10485760
SENSOR_IMPORT_MAX_ROWS=50000
SENSOR_IMPORT_PREVIEW_ROWS=25
SENSOR_IMPORT_BATCH_SIZE=250
SENSOR_IMPORT_ERROR_URL_TTL_SECONDS=300
DEVICE_BATCH_MAX_READINGS=500
DEVICE_BATCH_MAX_BYTES=262144
DEVICE_FUTURE_TOLERANCE_SECONDS=300
SENSOR_STALE_MULTIPLIER=3
MQTT_ENABLED=false
MQTT_BROKER_URL=mqtts://broker.example.com:8883
MQTT_CA_FILE=
MQTT_CLIENT_CERT_FILE=
MQTT_CLIENT_KEY_FILE=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_QUEUE_CAPACITY=1000
MQTT_MESSAGE_MAX_BYTES=65536
EDGE_BUFFER_MAX_ROWS=100000
EDGE_BATCH_MAX_READINGS=100
EDGE_BATCH_MAX_BYTES=131072
EDGE_RETRY_BASE_SECONDS=1
EDGE_RETRY_MAX_SECONDS=60
OPCUA_ENDPOINT=
OPCUA_CLIENT_CERT_FILE=
OPCUA_CLIENT_KEY_FILE=
OPCUA_POLL_INTERVAL_SECONDS=5
REALITYLOOP_API_URL=
REALITYLOOP_DEVICE_CREDENTIAL=
REALITYLOOP_EDGE_BUFFER=realityloop-edge.sqlite3
PUBLIC_APP_URL=http://127.0.0.1:5173
VITE_API_BASE_URL=/api/v1
COOKIE_SECURE=false
SESSION_TTL_SECONDS=43200
VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=RealityLoop AI <no-reply@realityloop.local>
SMTP_STARTTLS=false
SMTP_SSL=false
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_LOGIN_LIMIT=10
AUTH_REGISTER_LIMIT=5
AUTH_RECOVERY_LIMIT=4
AUTH_VERIFICATION_LIMIT=5

# Gemini (photo analysis + historical evidence). Set ONLY on the Celery worker, never on the API or in Vercel.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
PHOTO_MAX_IMAGES=6
PHOTO_MAX_IMAGE_BYTES=8388608
PHOTO_JOB_TIMEOUT_SECONDS=90
PHOTO_JOB_MAX_RETRIES=2
