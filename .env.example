# Local development only. Replace credentials before any shared deployment.
MONGO_ROOT_USERNAME=realityloop-local
MONGO_ROOT_PASSWORD=replace-with-a-local-mongodb-password
MONGO_DATABASE=realityloop
MONGO_APP_USERNAME=realityloop-app
MONGO_APP_PASSWORD=replace-with-a-local-application-database-password
MINIO_ROOT_USER=realityloop-local
MINIO_ROOT_PASSWORD=replace-with-a-local-minio-password
MINIO_BUCKET=realityloop
PUBLIC_APP_URL=http://localhost:8080
COOKIE_SECURE=false
SESSION_TTL_SECONDS=43200
VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=RealityLoop AI <no-reply@realityloop.local>
SMTP_STARTTLS=false
SMTP_SSL=false
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_LOGIN_LIMIT=10
AUTH_REGISTER_LIMIT=5
AUTH_RECOVERY_LIMIT=4
AUTH_VERIFICATION_LIMIT=5
