From 0b20c58c3cfe63a5d3bb4c27909aab4f1b6b466c Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Mon, 2 Nov 2026 18:01:20 +0100
Subject: [PATCH] Deploy one free API and use MongoDB for request limits

---
 backend/app/api/routes/health.py              |  4 ++--
 backend/app/core/config.py                    |  5 ++--
 backend/app/core/rate_limit.py                | 24 ++++++++++++++++++-
 backend/app/db/migrations/runner.py           |  3 +++
 .../migrations/versions/v0005_rate_windows.py |  5 ++++
 backend/tests/test_migrations.py              |  3 ++-
 render.yaml                                   | 14 ++++-------
 7 files changed, 43 insertions(+), 15 deletions(-)
 create mode 100644 backend/app/db/migrations/versions/v0005_rate_windows.py

diff --git a/backend/app/api/routes/health.py b/backend/app/api/routes/health.py
index b55bb4e..1a4fdbb 100644
--- a/backend/app/api/routes/health.py
+++ b/backend/app/api/routes/health.py
@@ -95,10 +95,10 @@ def check_smtp() -> bool:
 def readiness(request: Request, response: Response) -> dict[str, object]:
     dependencies = {
         "mongodb": check_database(),
-        "redis": check_redis(),
-        "object_storage": check_object_storage(),
         "smtp": check_smtp(),
     }
+    if not get_settings().mongo_only_infra:
+        dependencies.update(redis=check_redis(), object_storage=check_object_storage())
     ready = all(dependencies.values())
     if not ready:
         response.status_code = 503
diff --git a/backend/app/core/config.py b/backend/app/core/config.py
index 9183fda..8c11e71 100644
--- a/backend/app/core/config.py
+++ b/backend/app/core/config.py
@@ -7,6 +7,7 @@ from pydantic_settings import BaseSettings, SettingsConfigDict
 class Settings(BaseSettings):
     app_name: str = "RealityLoop API"
     environment: str = "development"
+    mongo_only_infra: bool = False
     log_level: str = "INFO"
     mongo_uri: str = Field(default="", validation_alias="MONGO_URI")
     mongo_host: str = "localhost"
@@ -93,9 +94,9 @@ class Settings(BaseSettings):
                 raise ValueError(
                     "Production MongoDB requires an authenticated remote cluster URI."
                 )
-            if not self.redis_url.startswith("rediss://"):
+            if not self.mongo_only_infra and not self.redis_url.startswith("rediss://"):
                 raise ValueError("Production REDIS_URL must use TLS (rediss://).")
-            if not self.s3_bucket or not self.s3_access_key_id or not self.s3_secret_access_key:
+            if not self.mongo_only_infra and not (self.s3_bucket and self.s3_access_key_id and self.s3_secret_access_key):
                 raise ValueError(
                     "Production S3-compatible storage bucket credentials must be configured."
                 )
diff --git a/backend/app/core/rate_limit.py b/backend/app/core/rate_limit.py
index 184471a..9312e77 100644
--- a/backend/app/core/rate_limit.py
+++ b/backend/app/core/rate_limit.py
@@ -1,3 +1,7 @@
+from datetime import UTC, datetime
+from pymongo import ReturnDocument
+from pymongo.errors import PyMongoError
+
 import hashlib
 import logging
 
@@ -6,7 +10,7 @@ from redis import Redis
 from redis.exceptions import RedisError
 
 from app.core.config import get_settings
-from app.db.client import get_redis_client
+from app.db.client import get_database, get_redis_client
 
 logger = logging.getLogger(__name__)
 
@@ -54,6 +58,24 @@ def check_request_limit(
     identity: str,
     limit: int,
 ) -> None:
+    settings = get_settings()
+    if settings.mongo_only_infra:
+        window = settings.auth_rate_limit_window_seconds
+        bucket = int(datetime.now(UTC).timestamp()) // window
+        ip = request.client.host if request.client else "unknown"
+        key = rate_limit_key(action, identity, ip)
+        expires = datetime.fromtimestamp((bucket + 1) * window, UTC)
+        try:
+            record = get_database().auth_rate_windows.find_one_and_update(
+                {"_id": f"{key}:{bucket}"},
+                {"$inc": {"count": 1}, "$setOnInsert": {"expires_at": expires}},
+                upsert=True, return_document=ReturnDocument.AFTER,
+            )
+        except PyMongoError:
+            raise HTTPException(status_code=503, detail="Authentication is temporarily unavailable.")
+        if record["count"] > limit:
+            raise HTTPException(status_code=429, detail="Too many attempts.", headers={"Retry-After": str(window)})
+        return
     client = get_redis_client()
     check_rate_limit(
         client,
diff --git a/backend/app/db/migrations/runner.py b/backend/app/db/migrations/runner.py
index 09d7dc0..b2af969 100644
--- a/backend/app/db/migrations/runner.py
+++ b/backend/app/db/migrations/runner.py
@@ -8,11 +8,14 @@ from app.db.migrations.versions import v0002_authentication
 from app.db.migrations.versions import v0003_factory_assets
 from app.db.migrations.versions import v0004_production_line_models
 
+from app.db.migrations.versions import v0005_rate_windows
+
 MIGRATIONS = (
     v0001_identity_foundation,
     v0002_authentication,
     v0003_factory_assets,
     v0004_production_line_models,
+    v0005_rate_windows,
 )
 
 
diff --git a/backend/app/db/migrations/versions/v0005_rate_windows.py b/backend/app/db/migrations/versions/v0005_rate_windows.py
new file mode 100644
index 0000000..3a7e0a7
--- /dev/null
+++ b/backend/app/db/migrations/versions/v0005_rate_windows.py
@@ -0,0 +1,5 @@
+VERSION = "0005_rate_windows"
+
+
+def upgrade(database) -> None:
+    database.auth_rate_windows.create_index("expires_at", expireAfterSeconds=0)
diff --git a/backend/tests/test_migrations.py b/backend/tests/test_migrations.py
index 6771cd0..25cd5e3 100644
--- a/backend/tests/test_migrations.py
+++ b/backend/tests/test_migrations.py
@@ -96,12 +96,13 @@ def test_identity_migration_is_versioned_and_repeatable() -> None:
         "0002_authentication",
         "0003_factory_assets",
         "0004_production_line_models",
+        "0005_rate_windows",
     ]
     assert migrate(database) == []
     assert {"organizations", "users", "organization_memberships", "schema_migrations"} <= set(
         database.list_collection_names()
     )
-    assert len(database["schema_migrations"].documents) == 4
+    assert len(database["schema_migrations"].documents) == 5
     assert database.organizations.options["validator"] == initial_migration.COLLECTIONS[
         "organizations"
     ]
diff --git a/render.yaml b/render.yaml
index 8edb914..290b95e 100644
--- a/render.yaml
+++ b/render.yaml
@@ -3,15 +3,11 @@ services:
     name: realityloop-api
     runtime: python
     rootDir: backend
-    plan: starter
+    plan: free
     buildCommand: pip install -r requirements.lock
     startCommand: uvicorn app.main:app --host 0.0.0.0 --port $PORT
     healthCheckPath: /api/v1/health/live
-
-  - type: worker
-    name: realityloop-worker
-    runtime: python
-    rootDir: backend
-    plan: starter
-    buildCommand: pip install -r requirements.lock
-    startCommand: celery -A app.worker.celery_app:celery_app worker --loglevel=INFO
+    envVars:
+      - fromGroup: realityloop-production
+      - key: MONGO_ONLY_INFRA
+        value: "true"
