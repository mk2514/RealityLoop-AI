ENVIRONMENT=development
LOG_LEVEL=INFO
MONGO_URI=
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=realityloop
MONGO_APP_USERNAME=realityloop-app
MONGO_APP_PASSWORD=replace-with-a-local-application-database-password
MONGO_AUTH_SOURCE=realityloop
REDIS_URL=redis://localhost:6379/0
FRONTEND_ORIGINS=http://localhost:5173
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
PUBLIC_APP_URL=http://localhost:3000
VITE_API_BASE_URL=/api/v1
COOKIE_SECURE=false
SESSION_TTL_SECONDS=43200
VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=RealityLoop AI <no-reply@realityloop.local>
SMTP_STARTTLS=false
SMTP_SSL=false
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_LOGIN_LIMIT=10
AUTH_REGISTER_LIMIT=5
AUTH_RECOVERY_LIMIT=4
AUTH_VERIFICATION_LIMIT=5
